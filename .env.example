GROQ_API_KEY=your_groq_api_key_here
# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b   # used when the main model hits its usage limit
# SERVICENOW_EXPORT_DIR=C:\Users\PM\ServiceNowData
# COPILOT_TODAY=2026-09-25
# COPILOT_RERANK=0   # turn off the LLM re-ranking of similar incidents (on by default)

# Incident source: "workbook" (default, the Excel export) or "servicenow" (Table API).
# For the local mock:  python -m uvicorn servicenow_mock.server:app --port 8600
# INCIDENT_SOURCE=servicenow
# SERVICENOW_URL=http://localhost:8600
# SERVICENOW_USER=admin
# SERVICENOW_PASSWORD=admin      # local mock only; use your real credentials for a real instance

# Sign-in. Required by default; each user signs in with the password in COPILOT_PASSWORD_<USER ID>
# (user id in capitals, "." -> "_"). Users without a password can't sign in.
# COPILOT_AUTH=off                      # local development only
# COPILOT_PASSWORD_TEAM_LEAD=
# COPILOT_PASSWORD_RAJESH_KUMAR=
# COPILOT_PASSWORD_SARAH_JENKINS=
# COPILOT_PASSWORD_KNOWLEDGE_MGR=
